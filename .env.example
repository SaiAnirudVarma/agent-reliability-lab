# Execution mode is always explicit -- never inferred from which API keys
# happen to be set.
#
#   mock -- run DeterministicBaselineAgent. No network calls, no credentials
#           needed. This is also the CLI's default with no flags at all.
#   llm  -- run LLMAgent against a real hosted model. Requires
#           MODEL_PROVIDER, MODEL_NAME, and that provider's API key below.
AGENT_MODE=mock

# Required only when AGENT_MODE=llm (or when running
# `python scripts/run_eval.py --agent llm`).
#
# MODEL_NAME is pinned to an exact, dated snapshot (not a rolling alias) for
# experimental reproducibility -- a historical result should always be
# attributable to one fixed model version.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.4-mini-2026-03-17

# Provider credentials -- only the one matching MODEL_PROVIDER is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional cost estimation. estimated_cost stays None (never fabricated)
# unless ALL THREE of these are set. There is no built-in price table --
# you must supply the price you were actually quoted, and the date you
# recorded it, so a run's cost estimate always carries its own documented
# assumptions instead of a silently stale hardcoded number.
LLM_INPUT_PRICE_PER_1K=
LLM_OUTPUT_PRICE_PER_1K=
LLM_PRICING_AS_OF=

# Required only for `python scripts/run_retrieval_eval.py --retriever vector`
# (embedding-backed retrieval). Ignored for the default lexical retriever,
# which never touches the network. EMBEDDING_MODEL_NAME/EMBEDDING_DIMENSION
# must match a frozen config's own recorded values when --config is used.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Required only for `python scripts/run_reranking_eval.py` (real reranking
# runs). Only 'cohere' is implemented.
RERANKER_PROVIDER=cohere
COHERE_API_KEY=

# Fail-closed gate for ALL real provider calls above (OpenAI, embeddings,
# Cohere): every real-provider script refuses to construct a provider
# client unless this is set to EXACTLY "1". A credential being present
# above never authorizes a call by itself -- see
# app/observability/real_api_gate.py and
# docs/incidents/2026-09-24-unauthorized-real-openai-calls-during-phase-8a-smoketest.md.
# Leave unset (the safe default) unless you specifically intend to spend a
# real API call right now.
ARL_ALLOW_REAL_API_CALLS=
